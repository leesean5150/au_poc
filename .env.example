# Copy to .env — docker compose reads it automatically.
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm
POSTGRES_DB=crm
DB_HOST_PORT=5433                          # host port for pgAdmin/psql -> container 5432
DATABASE_URL=postgresql+psycopg://crm:crm@db:5432/crm
CORS_ORIGINS=http://localhost:5173
APP_NOW=2026-01-05                         # freeze "today" near the Jan 2026 sample data
VITE_API_BASE=http://localhost:8000/api
